flowchart TB
    spa["<b>Web Client</b> <i>[Container: React SPA]</i>"]

    subgraph apiapp["API Application [Container: FastAPI]"]
        routers["<b>REST Routers</b><br/><i>[Component]</i><br/>/auth /events /imports /review /reports"]
        auth["<b>Auth</b><br/><i>[Component]</i><br/>Argon2, JWT cookie,<br/>staff login"]
        events["<b>Event Manager</b><br/><i>[Component]</i><br/>Events and their metadata"]
        import["<b>Import Pipeline</b><br/><i>[Component]</i><br/>Source adapters (4 templates)<br/>→ Validator → Normalizer"]
        reports["<b>Reporting & Export</b><br/><i>[Component]</i><br/>On-page reports, filters,<br/>CSV export"]
        exact["<b>Exact Matcher</b><br/><i>[Component]</i><br/>NetID → normalized email<br/>(never student ID alone)"]
        ranker["<b>Candidate Ranker</b><br/><i>[Component]</i><br/>Name/email similarity, student ID<br/>as a hint; score + reasons, top 3"]
        review["<b>Review Queue</b><br/><i>[Component]</i><br/>Same person / keep separate"]
        recon["<b>Reconciliation Engine</b><br/><i>[Component]</i><br/>Attended, absent,<br/>walk-in, unresolved"]
    end

    db[("<b>Database</b> <i>[Container: PostgreSQL]</i>")]

    spa -->|"JSON / HTTPS"| routers
    routers --> auth
    routers --> events
    routers --> import
    routers -->|"Staff decisions"| review
    routers --> reports
    import -->|"Source records"| exact
    exact -->|"No exact match"| ranker
    ranker -->|"Candidates"| review
    exact -->|"Linked records"| recon
    review -->|"Decisions"| recon
    recon --> db
    reports --> db
    events --> db

    classDef container fill:#438dd5,stroke:#2e6295,color:#fff
    classDef component fill:#85bbf0,stroke:#5d82a8,color:#000
    class spa,db container
    class routers,auth,events,import,reports,exact,ranker,review,recon component
