# Postgres passwords must be URL-safe (letters and digits only): they are embedded in the
# connection URLs below.
# Postgres superuser password (docker compose / local dev)
POSTGRES_PASSWORD=changeme
# Password for the hub_app role (read/write app role)
HUB_APP_PASSWORD=changeme
# Password for the chatbot_ro role (read-only, used only by the chat executor)
CHATBOT_RO_PASSWORD=changeme
# App database connection (hub_app role)
DATABASE_URL=postgresql+psycopg://hub_app:changeme@localhost:5432/hub
# Read-only chatbot connection (chatbot_ro role)
CHATBOT_DATABASE_URL=postgresql+psycopg://chatbot_ro:changeme@localhost:5432/hub
# Admin connection used by tests to create and drop test databases
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/postgres
# Fernet key; generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_SECRET_KEY=
# Auth mode (only "none" is supported in the MVP)
AUTH_MODE=none
# Max rows shown in the UI result table
DISPLAY_ROW_CAP=1000
# Max rows in a chat-result export (S3); the full-dataset export is uncapped
EXPORT_ROW_CAP=100000
# Max rows of a query result passed back to the LLM
LLM_RESULT_MAX_ROWS=200
# Max characters of a query result passed back to the LLM
LLM_RESULT_MAX_CHARS=20000
# Timeout in seconds for a single LLM call
LLM_TIMEOUT_S=30
# Postgres statement timeout in milliseconds for chatbot queries
STATEMENT_TIMEOUT_MS=5000
# Overall timeout in seconds for one chat turn
TURN_TIMEOUT_S=90
# Max SQL generation attempts per chat turn
MAX_GENERATIONS=3
# Use the fake LLM provider (tests and demos only)
HUB_ENABLE_FAKE_LLM=false
# Max upload size in bytes (10 MB)
MAX_UPLOAD_BYTES=10485760
